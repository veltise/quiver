# Supabase — create a project at https://supabase.com
# Found in: Project Settings → API

# Project URL (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (safe to expose in the browser, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — never expose this in the browser or commit it)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
