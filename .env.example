# Supabase — create a project at https://supabase.com
# Found in: Project Settings → API

# Project URL (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (safe to expose in the browser, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — never expose this in the browser or commit it)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random string used to hash client IPs before they're used as rate-limit keys
# (raw IPs are never stored). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=a-long-random-string

# Sentry error monitoring (optional — see README "Error monitoring")
SENTRY_AUTH_TOKEN=your-sentry-auth-token
